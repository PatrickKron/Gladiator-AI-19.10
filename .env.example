# Gladiator AI v2 — Pflicht-Umgebungsvariablen.
# KEINE Fallbacks im Code: fehlt eine Pflicht-Variable, bricht der Boot ab.
# Echte Werte liegen NUR in der .env auf dem Server (nie committen).

# Infrastruktur (docker-compose)
POSTGRES_PASSWORD=CHANGE_ME

# Anwendungen
DATABASE_URL=postgres://gladiator:CHANGE_ME@127.0.0.1:5433/gladiator
REDIS_URL=redis://127.0.0.1:6380

# Auth (Phase 0b) — Pflicht, kein Fallback
JWT_SECRET=CHANGE_ME_64_HEX

# API-Server (optional, Defaults: 127.0.0.1:3010)
# API_HOST=127.0.0.1
# API_PORT=3010
# CORS_ORIGINS=https://example.com  (kommasepariert; leer = keine Cross-Origin-Zugriffe)

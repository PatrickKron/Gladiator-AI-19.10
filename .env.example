# Gladiator AI v2 — Pflicht-Umgebungsvariablen.
# KEINE Fallbacks im Code: fehlt eine Pflicht-Variable, bricht der Boot ab.
# Echte Werte liegen NUR in der .env auf dem Server (nie committen).

# Infrastruktur (docker-compose)
POSTGRES_PASSWORD=CHANGE_ME

# Anwendungen
DATABASE_URL=postgres://gladiator:CHANGE_ME@127.0.0.1:5433/gladiator
REDIS_URL=redis://127.0.0.1:6380

# Auth (Phase 0b) — Pflicht, kein Fallback
JWT_SECRET=CHANGE_ME_64_HEX

# Vault (Phase 0c) — Pflicht, exakt 64 Hex-Zeichen (256 Bit), kein Fallback
ENCRYPTION_KEY=CHANGE_ME_64_HEX

# Trading-Venues (Phase 4b/4c) — Zugänge legt NUR Patrick an; ohne sie läuft
# die interne Paper-Engine gegen echte Live-Preise. Auswahl via TRADING_VENUE.
# BINANCE_TESTNET_KEY=...        (testnet.binancefuture.com)
# BINANCE_TESTNET_SECRET=...
# HYPERLIQUID_TESTNET_WALLET=0x...      (Haupt-Wallet-ADRESSE, public)
# HYPERLIQUID_TESTNET_AGENT_KEY=0x...   (Private Key der AGENT-Wallet — kann NICHT auszahlen)
# TRADING_VENUE=paper | binance-testnet | hyperliquid-testnet

# Agenten-Schwarm & LLM (Phase 5) — ohne Key sind Makro/Shadow-Agent und die
# Text→DSL-Übersetzung ehrlich deaktiviert (sichtbar markiert, nie Zufallswerte).
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_DAILY_BUDGET_USD=5     (Kosten-Wächter: Tagesbudget für LLM-Aufrufe)

# Pine-/TradingView-Webhook (Phase 5) — ohne Secret ist /api/webhook/pine deaktiviert (503).
# Secret entweder als Body-Feld "secret" (TradingView) oder Header x-gladiator-signature (HMAC-SHA256).
# PINE_WEBHOOK_SECRET=CHANGE_ME_LANGES_ZUFALLSSECRET

# API-Server (optional, Defaults: 127.0.0.1:3010)
# API_HOST=127.0.0.1
# API_PORT=3010
# CORS_ORIGINS=https://example.com  (kommasepariert; leer = keine Cross-Origin-Zugriffe)
